APP_ENV=development
# Docker-only host port and browser origin (change both together).
COMPOSE_PORT=8080
COMPOSE_PUBLIC_URL=http://localhost:8080
APP_PUBLIC_URL=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=shoppulse
DATABASE_USER=shoppulse
# Local relative paths resolve from the repository root. Compose overrides these.
DATABASE_PASSWORD_FILE=secrets/database_password
CREDENTIAL_MASTER_KEY_FILE=secrets/credential_master_key
CREDENTIAL_KEY_VERSION=1
# Keep old files available during rotation; map old version to its secret file path.
CREDENTIAL_OLD_KEYS={}
# Exact origins only, configured by the deployer. Empty means public HTTPS port 443 only.
MODEL_ALLOWED_ORIGINS=[]
STORAGE_ROOT=data
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=15
JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
MAX_UPLOAD_MIB=20
MAX_IMPORT_ROWS=100000
PARSE_TIMEOUT_SECONDS=120
